{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kasus-maksi",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/kasus-2-coretax/*",
      "/panduan-mahasiswa/data/kasus-2.txt"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "PRESENTATIONS",
      "id": "33f8f6935c154ab3a55af9483cda4078"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "CASE2_ACTIVATION_SECRET",
      "store_id": "57983645c58e4759a494fe4cfbaaaca4",
      "secret_name": "CASE2_ACTIVATION_SECRET"
    },
    {
      "binding": "INSTRUCTOR_ACCESS_SECRET",
      "store_id": "57983645c58e4759a494fe4cfbaaaca4",
      "secret_name": "INSTRUCTOR_ACCESS_SECRET"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CASE_STATE",
        "class_name": "CaseState"
      }
    ]
  },
  "exports": {
    "CaseState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
