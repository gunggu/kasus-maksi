{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kasus-maksi",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/kasus-2-coretax/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CASE_STATE",
        "class_name": "CaseState"
      }
    ]
  },
  "exports": {
    "CaseState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
